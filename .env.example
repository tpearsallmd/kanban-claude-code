# Kanban service configuration

# External port mapping (Docker host → container)
KANBAN_HOST_PORT=5555

# Internal container port (rarely needs to change)
KANBAN_PORT=5555

# Path to kanban board file inside the container volume
# Default: /data/kanban-board.json (persists in named volume)
# Can override to use a different filename or mount point
KANBAN_DATA_FILE=/data/kanban-board.json

# Hostname for remote deployments (optional)
# Set to your server hostname if deploying to a remote machine
# Agents will connect to http://${KANBAN_HOST}:${KANBAN_HOST_PORT}
# KANBAN_HOST=kanban.example.com
